{
  "name": "aionui-voice-input",
  "version": "2.1.6",
  "description": "Voice input button for AionUi, Open Cowork and other Electron chat apps: records audio, transcribes with Gemini, inserts it into the composer.",
  "keywords": [
    "electron",
    "voice",
    "speech-to-text",
    "dictation",
    "gemini",
    "asar",
    "aionui",
    "open-cowork",
    "cline",
    "reasonix",
    "accessibility",
    "windows"
  ],
  "license": "MIT",
  "author": "Xtrem-21",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtrem21-source/AionUi-Voice-Input.git"
  },
  "homepage": "https://github.com/xtrem21-source/AionUi-Voice-Input",
  "bugs": {
    "url": "https://github.com/xtrem21-source/AionUi-Voice-Input/issues"
  },
  "files": [
    "METHODOLOGY.md",
    "src/voice-input.open-cowork.js",
    "src/voice-input.aionui.js",
    "scripts/",
    "docs/",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "scripts": {
    "patch:aionui": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-patch.ps1 -Preset AionUi",
    "patch:opencowork": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-patch.ps1 -Preset OpenCowork",
    "test:regression": "node tests/non-regression.js --port 9222",
    "test:regression:launch": "powershell -ExecutionPolicy Bypass -File tests/non-regression.ps1 -Launch"
  },
  "engines": {
    "node": ">=18"
  }
}
