{
  "name": "aitron-voice-input",
  "version": "2.1.1",
  "description": "Voice input button for any Electron chat app — records audio, transcribes with Gemini, inserts it into the composer.",
  "keywords": [
    "electron",
    "voice",
    "speech-to-text",
    "dictation",
    "gemini",
    "asar",
    "cline",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Xtrem-21",
  "files": [
    "METHODOLOGY.md",
    "src/voice-input.js",
    "scripts/",
    "docs/",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "scripts": {
    "patch:aionui": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-patch.ps1 -Preset AionUi",
    "patch:opencowork": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-patch.ps1 -Preset OpenCowork"
  },
  "engines": {
    "node": ">=18"
  }
}
